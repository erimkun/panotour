# Panotour Environment Variables

# ===========================================
# Local Project Storage (Optional)
# ===========================================
# If set, project files are read/written from this folder.
# Example Linux path: /var/www/panotour-data/projects
# Example Windows path: C:\\panotour-data\\projects
# When this is set, local disk is preferred for writes.
PROJECTS_STORAGE_PATH=

# ===========================================
# EDIT SECRET (Required for server-side save)
# ===========================================
# Set this to enable saving config from browser
# Without this, only ZIP export will work
EDIT_SECRET=

# ===========================================
# Vercel Blob Storage (Optional)
# ===========================================
# For cloud storage on Vercel
# Get from: https://vercel.com/dashboard/stores
BLOB_READ_WRITE_TOKEN=

# ===========================================
# Notes
# ===========================================
# - PROJECTS_STORAGE_PATH: Preferred local storage directory for project files
# - EDIT_SECRET: Used to protect POST /api/projects/{code}/config endpoint
# - BLOB_READ_WRITE_TOKEN: Enables Vercel Blob storage for deployments
# 
# Deployment Options:
# 1. Static Export (ZIP): No env vars needed, just export ZIP and deploy
# 2. Server Mode: Set EDIT_SECRET for live editing
# 3. Self-hosted + Local Disk: Set PROJECTS_STORAGE_PATH and EDIT_SECRET
# 4. Vercel + Blob: Set EDIT_SECRET and BLOB_READ_WRITE_TOKEN
