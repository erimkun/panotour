NODE_ENV=production
PORT=3000

# Local project storage path. Preferred on self-hosted servers.
PROJECTS_STORAGE_PATH=/var/www/panotour-data/projects

# Required for save operations from the editor.
EDIT_SECRET=change-this-edit-secret

# Required for admin ZIP upload authentication.
ADMIN_PASSWORD=change-this-admin-password

# Optional. If PROJECTS_STORAGE_PATH is not set, Blob will be used.
BLOB_READ_WRITE_TOKEN=
