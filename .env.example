# Panotour Environment Variables

# ===========================================
# Local Project Storage (Optional)
# ===========================================
# If set, project files are read/written from this folder.
# Example Linux path: /var/www/panotour-data/projects
# Example Windows path: C:\\panotour-data\\projects
# When this is set, local disk is preferred for writes.
PROJECTS_STORAGE_PATH=

# ===========================================
# EDIT SECRET (Required for server-side save)
# ===========================================
# Set this to enable saving config from browser
# Without this, only ZIP export will work
EDIT_SECRET=

# ===========================================
# Vercel Blob Storage (Optional)
# ===========================================
# For cloud storage on Vercel
# Get from: https://vercel.com/dashboard/stores
BLOB_READ_WRITE_TOKEN=

# ===========================================
# AI Panorama Generation (Optional)
# ===========================================
# Prefer setting AI provider/model/key from Admin panel.
# Those values are session-only (in-memory) and are NOT written to disk.
#
# Optional env fallback (used only if admin oturum ayari verilmezse):
# PANORAMA_AI_PROVIDER=
# PANORAMA_AI_API_URL=
# PANORAMA_AI_MODEL=
# PANORAMA_AI_API_KEY=
#
# PANORAMA_OLLAMA_BASE_URL=http://localhost:11434
# PANORAMA_OLLAMA_MODEL=llava:latest
#
# PANORAMA_VLLM_BASE_URL=http://localhost:8000
# PANORAMA_VLLM_MODEL=
# PANORAMA_VLLM_API_KEY=
#
# PANORAMA_GEMINI_API_KEY=
# PANORAMA_GEMINI_MODEL=gemini-3.1-flash-image-preview
# PANORAMA_GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
#
# PANORAMA_GROK_API_KEY=
# PANORAMA_GROK_MODEL=grok-2-vision-latest
# PANORAMA_GROK_API_URL=https://api.x.ai
# PANORAMA_VERTEX_API_URL=https://aiplatform.googleapis.com/v1
# PANORAMA_VERTEX_PROJECT_ID=
# PANORAMA_VERTEX_LOCATION=us-central1
# PANORAMA_VERTEX_MODEL=gemini-2.5-flash
# PANORAMA_VERTEX_AUTH_MODE=oauth
# PANORAMA_VERTEX_ACCESS_TOKEN=
# PANORAMA_VERTEX_EXPRESS_API_KEY=

# ===========================================
# Notes
# ===========================================
# - PROJECTS_STORAGE_PATH: Preferred local storage directory for project files
# - EDIT_SECRET: Used to protect POST /api/projects/{code}/config endpoint
# - BLOB_READ_WRITE_TOKEN: Enables Vercel Blob storage for deployments
# - PANORAMA_*: Optional fallback for POST /api/panorama/generate (recommended: Admin panel session settings)
# 
# Deployment Options:
# 1. Static Export (ZIP): No env vars needed, just export ZIP and deploy
# 2. Server Mode: Set EDIT_SECRET for live editing
# 3. Self-hosted + Local Disk: Set PROJECTS_STORAGE_PATH and EDIT_SECRET
# 4. Vercel + Blob: Set EDIT_SECRET and BLOB_READ_WRITE_TOKEN
